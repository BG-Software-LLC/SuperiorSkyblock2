    @Override
    public CapturedBlocks captureBlocks(Location center, double radius) {
        ServerLevel serverLevel = ((CraftWorld) center.getWorld()).getHandle();

        int minChunkX = (int) Math.floor(center.getX() - radius) >> 4;
        int maxChunkX = (int) Math.floor(center.getX() + radius) >> 4;
        int minChunkZ = (int) Math.floor(center.getZ() - radius) >> 4;
        int maxChunkZ = (int) Math.floor(center.getZ() + radius) >> 4;

        Map<Long, LevelChunk> chunks = new HashMap<>();

        for (int chunkX = minChunkX; chunkX <= maxChunkX; ++chunkX) {
            for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; ++chunkZ) {
                ChunkAccess chunkAccess;
                try {
                    chunkAccess = serverLevel.getChunkIfLoadedImmediately(chunkX, chunkZ);
                } catch (Throwable error) {
                    // Not running on Paper.
                    chunkAccess = serverLevel.getChunkIfLoaded(chunkX, chunkZ);
                }

                if (chunkAccess instanceof LevelChunk)
                    chunks.put(getChunkKey(chunkX, chunkZ), (LevelChunk) chunkAccess);
            }
        }

        return new CapturedBlocksImpl(chunks);
    }

    private static long getChunkKey(int chunkX, int chunkZ) {
        return ((long) chunkX << 32) | (chunkZ & 0xFFFFFFFFL);
    }

