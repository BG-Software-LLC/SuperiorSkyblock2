        @Override
        public float getMaxScale(CapturedBlocks capturedBlocks, float width, float height) {
            // The panel is pulled towards the viewer until no ray from his eyes to the panel hits a block.
            // As the panel is scaled down by the same amount, it looks the same to the viewer.
            Map<Long, LevelChunk> chunks = ((CapturedBlocksImpl) capturedBlocks).chunks;
            Vec3 eyes = new Vec3(this.originX, this.originY, this.originZ);

            double yawRadians = Math.toRadians(this.yaw);
            double forwardX = -Math.sin(yawRadians);
            double forwardZ = Math.cos(yawRadians);
            double rightX = -Math.cos(yawRadians);
            double rightZ = -Math.sin(yawRadians);

            int raysX = getRaysCount(width);
            int raysY = getRaysCount(height);

            float maxScale = 1f;

            // The mirror of the panel behind the viewer must not be hidden by blocks either.
            for (int side = 1; side >= -1; side -= 2) {
                for (int i = 0; i < raysX; ++i) {
                    double x = width * ((double) i / (raysX - 1) - 0.5);
                    for (int j = 0; j < raysY; ++j) {
                        double y = height * ((double) j / (raysY - 1) - 0.5);
                        double directionX = (forwardX * this.distance + rightX * x) * side;
                        double directionY = y;
                        double directionZ = (forwardZ * this.distance + rightZ * x) * side;
                        double length = Math.sqrt(directionX * directionX + directionY * directionY + directionZ * directionZ);
                        double hitDistance = traceBlocks(chunks, eyes, eyes.add(directionX, directionY, directionZ));
                        if (hitDistance >= 0)
                            maxScale = Math.min(maxScale, (float) ((hitDistance - FIT_MARGIN) / length));
                    }
                }
            }

            return Math.max(maxScale, MIN_DISTANCE / this.distance);
        }

        /**
         * Find the first block a line from {@code from} to {@code to} hits, using the outlines of blocks.
         * Blocks are visited in the order the line passes through them.
         *
         * @return The distance from {@code from} to where the line hits a block, or -1 if it does not hit any.
         */
        private static double traceBlocks(Map<Long, LevelChunk> chunks, Vec3 from, Vec3 to) {
            double deltaX = to.x - from.x;
            double deltaY = to.y - from.y;
            double deltaZ = to.z - from.z;

            int x = (int) Math.floor(from.x);
            int y = (int) Math.floor(from.y);
            int z = (int) Math.floor(from.z);

            int stepX = (int) Math.signum(deltaX);
            int stepY = (int) Math.signum(deltaY);
            int stepZ = (int) Math.signum(deltaZ);

            // How much of the line is passed when moving a whole block on each axis, and when reaching the next block.
            double stepLengthX = stepX == 0 ? Double.MAX_VALUE : Math.abs(1 / deltaX);
            double stepLengthY = stepY == 0 ? Double.MAX_VALUE : Math.abs(1 / deltaY);
            double stepLengthZ = stepZ == 0 ? Double.MAX_VALUE : Math.abs(1 / deltaZ);
            double nextX = stepX == 0 ? Double.MAX_VALUE : (stepX > 0 ? x + 1 - from.x : from.x - x) * stepLengthX;
            double nextY = stepY == 0 ? Double.MAX_VALUE : (stepY > 0 ? y + 1 - from.y : from.y - y) * stepLengthY;
            double nextZ = stepZ == 0 ? Double.MAX_VALUE : (stepZ > 0 ? z + 1 - from.z : from.z - z) * stepLengthZ;

            BlockPos.MutableBlockPos blockPos = new BlockPos.MutableBlockPos();

            while (true) {
                double hitDistance = hitBlock(chunks, blockPos.set(x, y, z), from, to);
                if (hitDistance >= 0)
                    return hitDistance;

                if (nextX < nextY && nextX < nextZ) {
                    if (nextX > 1)
                        return -1;
                    x += stepX;
                    nextX += stepLengthX;
                } else if (nextY < nextZ) {
                    if (nextY > 1)
                        return -1;
                    y += stepY;
                    nextY += stepLengthY;
                } else {
                    if (nextZ > 1)
                        return -1;
                    z += stepZ;
                    nextZ += stepLengthZ;
                }
            }
        }

        private static double hitBlock(Map<Long, LevelChunk> chunks, BlockPos.MutableBlockPos blockPos, Vec3 from, Vec3 to) {
            LevelChunk levelChunk = chunks.get(getChunkKey(blockPos.getX() >> 4, blockPos.getZ() >> 4));
            if (levelChunk == null)
                // Chunks that are not loaded are not shown to the viewer, so they cannot hide the panel.
                return -1;

            BlockState blockState = levelChunk.getBlockState(blockPos);
            if (blockState.isAir())
                return -1;

            VoxelShape shape = blockState.getShape(EmptyBlockGetter.INSTANCE, blockPos);
            if (shape.isEmpty())
                return -1;

            BlockHitResult hitResult = shape.clip(from, to, blockPos.immutable());
            return hitResult == null ? -1 : hitResult.getLocation().distanceTo(from);
        }

        private static int getRaysCount(float size) {
            return Math.max(2, Math.min(FIT_MAX_RAYS_PER_AXIS, (int) Math.ceil(size / FIT_RAYS_SPACING) + 1));
        }

