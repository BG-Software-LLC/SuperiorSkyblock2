    /* Items are flattened, so blocks look the same way they look in inventories. */
    private static final float ITEM_DEPTH = 0.001f;
    /* The maximum space between two rays that check whether blocks hide the panel, on the panel itself. */
    private static final float FIT_RAYS_SPACING = 0.2f;
    /* The area can be the entire screen of the viewer, in front of him and behind him, so the number of rays is limited. */
    private static final int FIT_MAX_RAYS_PER_AXIS = 16;
    /* The space that is kept between the panel and the blocks in front of it. */
    private static final double FIT_MARGIN = 0.05;
    /* The closest distance the panel can be drawn in, as blocks right in front of the viewer cannot be avoided. */
    private static final float MIN_DISTANCE = 0.1f;
