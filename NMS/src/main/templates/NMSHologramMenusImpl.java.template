        @Override
        public int addText(String text, float x, float y, float scale, boolean shadowed) {
            // Text is rendered above the entity, and not centered around it.
            Element element = createTextElement(0f, -(TEXT_LINE_HEIGHT * scale) / 2, new Vector3f(scale, scale, scale));
            element.textDisplay.setText(text);
            element.textDisplay.setShadowed(shadowed);
            element.textDisplay.setBackgroundColor(TRANSPARENT_COLOR);
            element.setPosition(x, y);
            return element.id;
        }

        @Override
        public int addTooltip(String text, float x, float y, float scale, int argb) {
            Element element = createTextElement(0f, 0f, new Vector3f(scale, scale, scale));
            element.textDisplay.setText(text);
            element.textDisplay.setShadowed(true);
            element.textDisplay.setAlignment(TextDisplay.TextAlignment.LEFT);
            element.textDisplay.setBackgroundColor(Color.fromARGB(argb));
            element.setPosition(x, y);
            return element.id;
        }

        @Override
        public int addRectangle(float x, float y, float width, float height, int argb) {
            // The background of a blank text is stretched to the size of the rectangle.
            float scaleX = width / BLANK_TEXT_WIDTH;
            float scaleY = height / BLANK_TEXT_HEIGHT;
            Element element = createTextElement(-BLANK_TEXT_CENTER_OFFSET * scaleX, -height / 2, new Vector3f(scaleX, scaleY, 1f));
            element.textDisplay.setText(" ");
            element.textDisplay.setShadowed(false);
            element.textDisplay.setBackgroundColor(Color.fromARGB(argb));
            element.setPosition(x, y);
            return element.id;
        }

        @Override
        public int addItem(ItemStack itemStack, float x, float y, float width, float height) {
            Display.ItemDisplay display = new Display.ItemDisplay(${ENTITY_TYPE_VALUES_CLASS}.ITEM_DISPLAY, this.serverPlayer.level());
            Element element = createElement(display, 0f, 0f, new Vector3f(width, height, ITEM_DEPTH), ITEM_ROTATION);
            ItemDisplay itemDisplay = (ItemDisplay) element.bukkitEntity;
            itemDisplay.setItemStack(itemStack);
            itemDisplay.setItemDisplayTransform(ItemDisplay.ItemDisplayTransform.GUI);
            element.setPosition(x, y);
            return element.id;
        }

        private Element createTextElement(float offsetX, float offsetY, Vector3f scale) {
            Element element = createElement(createDisplay(), offsetX, offsetY, scale, NO_ROTATION);
            element.textDisplay.setLineWidth(TEXT_LINE_WIDTH);
            element.textDisplay.setDefaultBackground(false);
            return element;
        }

        private Element createElement(Display display, float offsetX, float offsetY, Vector3f scale, AxisAngle4f rotation) {
            int id = this.nextElementId++;
            // All the elements are located in the eyes of the viewer, and are moved to the panel by their transformation.
            // Displays are rotated to face the viewer, therefore their z-axis points to the viewer.
            display.setPos(this.originX, this.originY, this.originZ);
            display.setYRot(this.yaw + 180f);
            float depth = -this.distance + LAYER_DEPTH * this.layer + ELEMENT_DEPTH * (id % ELEMENTS_PER_LAYER_DEPTH);
            // The mirror is only sent to the viewer, so the dummy entity is only used for its identifiers.
            Element element = new Element(id, display, createDisplay(), offsetX, offsetY, depth, scale, rotation, this.scale);
            element.bukkitEntity.setBrightness(FULL_BRIGHTNESS);
            // Makes the element move smoothly when it is being moved.
            element.bukkitEntity.setInterpolationDuration(1);
            this.elements.put(id, element);
            return element;
        }

        private Display.TextDisplay createDisplay() {
            return new Display.TextDisplay(${ENTITY_TYPE_VALUES_CLASS}.TEXT_DISPLAY, this.serverPlayer.level());
        }

        private Display.TextDisplay createDisplay(double x, double y, double z, float yaw) {
            Display.TextDisplay display = createDisplay();
            display.setPos(x, y, z);
            display.setYRot(yaw);
            return display;
        }

        @Override
        public void show() {
            if (!this.locked) {
                this.locked = true;
                lockView();
            }

            for (Element element : this.elements.values()) {
                if (!element.spawned) {
                    element.spawned = true;
                    spawnElement(element);
                }
            }
        }

        private void lockView() {
            // The camera of the viewer is locked on an entity that looks at the panel.
            // In order to keep receiving the rotation of the viewer while his camera is locked, he must ride an entity.
            this.cameraAnchor = createCameraAnchor();
            this.vehicleAnchor = createDisplay(this.serverPlayer.getX(), this.serverPlayer.getY(), this.serverPlayer.getZ(), this.yaw);

            spawnEntity(this.cameraAnchor);
            if (!this.cameraAnchorAttributes.isEmpty())
                sendPacket(new ClientboundUpdateAttributesPacket(this.cameraAnchor.getId(), this.cameraAnchorAttributes));
            spawnEntity(this.vehicleAnchor);

            // Clicks on nothing are not reported by the viewer when his hand is empty or when he is a spectator,
            // but clicks on entities always are. Invisible entities in front of his camera receive his clicks,
            // and behind it for the mirrored third person view.
            this.clickTarget = createClickTarget(1);
            this.mirroredClickTarget = createClickTarget(-1);
            spawnEntity(this.clickTarget);
            spawnEntity(this.mirroredClickTarget);

            sendPacket(new ClientboundSetCameraPacket(this.cameraAnchor));
            // Riding the vehicle shows the viewer how to dismount it in his action bar, which is replaced by nothing.
            // Paper sends action bars ahead of other packets that are not sent from the main thread, so both packets
            // are bundled. The viewer handles bundled packets together and in order, so the message is never drawn.
            sendBundle(createPassengersPacket(this.vehicleAnchor, this.serverPlayer.getId()),
                    new ClientboundSetActionBarTextPacket(Component.empty()));

            if (this.spectatorView) {
                // Spectators do not see their crosshair and their hands. The real game mode of the viewer is not changed.
                sendPacket(new ClientboundGameEventPacket(ClientboundGameEventPacket.CHANGE_GAME_MODE, GameType.SPECTATOR.getId()));
            }

            if (this.channel != null) {
                Channel channel = this.channel;
                PacketHandler packetHandler = this.packetHandler;
                channel.eventLoop().execute(() -> {
                    if (channel.pipeline().get(CHANNEL_HANDLER_NAME) == null && channel.pipeline().get("packet_handler") != null)
                        channel.pipeline().addBefore("packet_handler", CHANNEL_HANDLER_NAME, packetHandler);
                });
            }

            hideViewer();
        }

        private void hideViewer() {
            // The viewer is made invisible on his side only, so his arm and his model in his inventory are not shown.
            sendPacket(createSharedFlagsPacket(this.serverPlayer.getId(), (byte) (this.viewerSharedFlags | INVISIBLE_FLAG)));

            if (this.packetHandler.handItemsHidden) {
                // Items in the hands of invisible players are still shown, so they are hidden on his side as well.
                // Changing them plays the animation of switching items, which spectators do not see.
                sendPacket(createInventorySlotPacket(this.serverPlayer, InventoryMenu.SHIELD_SLOT, net.minecraft.world.item.ItemStack.EMPTY));
                hideHeldItem(this.viewerHeldItemSlot);
            }
        }

        /**
         * Hide the item in a slot of the hotbar of the viewer, and show the item that was hidden before.
         * Called when the viewer selects a different slot in his hotbar, from the main thread,
         * and when the menu is shown, from the menus thread.
         */
        synchronized void hideHeldItem(int hotbarSlot) {
            if (!this.locked || !this.packetHandler.handItemsHidden || hotbarSlot < 0 || hotbarSlot >= HOTBAR_SIZE ||
                    this.serverPlayer.hasDisconnected())
                return;

            int oldHotbarSlot = this.packetHandler.hiddenHotbarSlot;
            if (oldHotbarSlot == hotbarSlot)
                return;

            // The packet handler must know the new hidden slot before the item of the old one is sent.
            this.packetHandler.hiddenHotbarSlot = hotbarSlot;

            if (oldHotbarSlot != -1) {
                int oldSlot = InventoryMenu.USE_ROW_SLOT_START + oldHotbarSlot;
                sendPacket(createInventorySlotPacket(this.serverPlayer, oldSlot, this.serverPlayer.inventoryMenu.getSlot(oldSlot).getItem()));
            }

            sendPacket(createInventorySlotPacket(this.serverPlayer, InventoryMenu.USE_ROW_SLOT_START + hotbarSlot,
                    net.minecraft.world.item.ItemStack.EMPTY));
        }

        /**
         * Show the real state of the viewer to him again. Called from the main thread.
         */
        private void showViewer() {
            if (this.spectatorView) {
                sendPacket(new ClientboundGameEventPacket(ClientboundGameEventPacket.CHANGE_GAME_MODE,
                        this.serverPlayer.gameMode.getGameModeForPlayer().getId()));
                // Changing the game mode on the side of the viewer changed his abilities as well, such as flying.
                this.serverPlayer.onUpdateAbilities();
            }

            sendPacket(createSharedFlagsPacket(this.serverPlayer.getId(), getSharedFlags(this.serverPlayer)));

            if (this.packetHandler.handItemsHidden) {
                // All the items of the viewer are sent again, including the ones that were hidden.
                this.serverPlayer.inventoryMenu.sendAllDataToRemote();
            }
        }

        /**
         * Create the entity the camera of the viewer is locked on.
         * It is a living entity, so its attributes can be changed:
         * - Its eye height is the same as the eye height of the viewer, and it is placed at his feet.
         *   The camera moves smoothly to the eye height of the entity it is locked on, which would be visible otherwise.
         * - Third person views (F5) do not move the camera away from it.
         */
        private ArmorStand createCameraAnchor() {
            ArmorStand armorStand = new ArmorStand(${ENTITY_TYPE_VALUES_CLASS}.ARMOR_STAND, this.serverPlayer.level());
            org.bukkit.entity.ArmorStand bukkitArmorStand = (org.bukkit.entity.ArmorStand) armorStand.getBukkitEntity();
            bukkitArmorStand.setInvisible(true);
            bukkitArmorStand.setGravity(false);
            bukkitArmorStand.setBasePlate(false);
            bukkitArmorStand.setArms(false);

            this.cameraAnchorAttributes.clear();

            float viewerEyeHeight = this.viewerEyeHeight;
            float armorStandEyeHeight = armorStand.getEyeHeight();
            float eyeHeight = setAttribute(armorStand, ${SCALE_ATTRIBUTE}, viewerEyeHeight / armorStandEyeHeight,
                    this.cameraAnchorAttributes) ? viewerEyeHeight : armorStandEyeHeight;
            setAttribute(armorStand, ${CAMERA_DISTANCE_ATTRIBUTE}, 0, this.cameraAnchorAttributes);

            armorStand.setPos(this.originX, this.originY - eyeHeight, this.originZ);
            armorStand.setYRot(this.yaw);
            armorStand.setYHeadRot(this.yaw);
            return armorStand;
        }

        /**
         * @param side 1 for the entity in front of the camera, -1 for the entity behind it.
         */
        private Interaction createClickTarget(int side) {
            Interaction interaction = new Interaction(${ENTITY_TYPE_VALUES_CLASS}.INTERACTION, this.serverPlayer.level());
            org.bukkit.entity.Interaction bukkitInteraction = (org.bukkit.entity.Interaction) interaction.getBukkitEntity();
            bukkitInteraction.setInteractionWidth(CLICK_TARGET_SIZE);
            bukkitInteraction.setInteractionHeight(CLICK_TARGET_SIZE);

            double yawRadians = Math.toRadians(this.yaw);
            // Interaction entities are centered horizontally around their position, and start from it vertically.
            interaction.setPos(this.originX - Math.sin(yawRadians) * CLICK_TARGET_DISTANCE * side,
                    this.originY - CLICK_TARGET_SIZE / 2,
                    this.originZ + Math.cos(yawRadians) * CLICK_TARGET_DISTANCE * side);
            return interaction;
        }

        /**
         * @param attribute The attribute to set, or null if it does not exist in this version.
         * @return Whether the attribute was set.
         */
        private static boolean setAttribute(LivingEntity entity, ${ATTRIBUTE_TYPE} attribute, double value,
                                            List<AttributeInstance> changedAttributes) {
            if (attribute == null)
                return false;

            AttributeInstance attributeInstance = entity.getAttribute(attribute);
            if (attributeInstance == null)
                return false;

            attributeInstance.setBaseValue(value);
            changedAttributes.add(attributeInstance);
            return true;
        }

        private void spawnEntity(Entity entity) {
            sendPacket(createAddEntityPacket(entity.getId(), entity.getUUID(), entity, entity.getYRot()));

            List<SynchedEntityData.DataValue<?>> entityData = entity.getEntityData().getNonDefaultValues();
            if (entityData != null && !entityData.isEmpty())
                sendPacket(new ClientboundSetEntityDataPacket(entity.getId(), entityData));

            // Marks all the data of the entity as sent.
            entity.getEntityData().packDirty();
        }

        private void spawnElement(Element element) {
            Display entity = element.entity;

            sendPacket(createAddEntityPacket(entity.getId(), entity.getUUID(), entity, entity.getYRot()));
            // The mirror of the element is turned around, so it is behind the viewer and faces him.
            // The mirrored third person view (F5) turns the camera around, and sees the mirror instead.
            sendPacket(createAddEntityPacket(element.mirrorId, element.mirrorUUID, entity, entity.getYRot() + 180f));

            List<SynchedEntityData.DataValue<?>> entityData = entity.getEntityData().getNonDefaultValues();
            if (entityData != null && !entityData.isEmpty())
                sendElementData(element, entityData);

            // Marks all the data of the entity as sent.
            entity.getEntityData().packDirty();
        }

        private static Packet<?> createAddEntityPacket(int entityId, UUID uuid, Entity entity, float yaw) {
            return new ClientboundAddEntityPacket(entityId, uuid,
                    entity.getX(), entity.getY(), entity.getZ(), entity.getXRot(), yaw,
                    entity.getType(), 0, Vec3.ZERO, yaw);
        }

        /**
         * Send data of an element to the viewer, for both the element and its mirror.
         */
        private void sendElementData(Element element, List<SynchedEntityData.DataValue<?>> entityData) {
            sendPacket(new ClientboundSetEntityDataPacket(element.entity.getId(), entityData));
            sendPacket(new ClientboundSetEntityDataPacket(element.mirrorId, entityData));
        }

        @Override
        public void moveElement(int elementId, float x, float y) {
            Element element = this.elements.get(elementId);
            if (element == null)
                return;

            element.setPosition(x, y, element.sizeScale);
            sendInterpolatedData(element);
        }

        @Override
        public void animateElement(int elementId, float x, float y, float scale, int duration) {
            Element element = this.elements.get(elementId);
            if (element == null)
                return;

            element.bukkitEntity.setInterpolationDuration(duration);
            element.setPosition(x, y, scale);
            sendInterpolatedData(element);
        }

        private void sendInterpolatedData(Element element) {
            if (!element.spawned)
                return;

            List<SynchedEntityData.DataValue<?>> entityData = element.entity.getEntityData().packDirty();
            if (entityData == null || entityData.isEmpty())
                return;

            // The transformation is only interpolated when the viewer is told when to start doing it.
            entityData = new ArrayList<>(entityData);
            entityData.add(getStartInterpolationData());

            sendElementData(element, entityData);
        }

        private SynchedEntityData.DataValue<?> getStartInterpolationData() {
            if (startInterpolationData == null) {
                // The data cannot be marked as dirty without changing it, so it is created manually.
                // Its identifier is found by changing it in a dummy entity.
                Display.TextDisplay display = createDisplay();
                ((TextDisplay) display.getBukkitEntity()).setInterpolationDelay(1);
                List<SynchedEntityData.DataValue<?>> entityData = display.getEntityData().packDirty();
                if (entityData == null || entityData.size() != 1)
                    throw new IllegalStateException("Cannot find the interpolation delay of display entities");
                startInterpolationData = createStartInterpolationData(entityData.get(0));
            }

            return startInterpolationData;
        }

        @SuppressWarnings("unchecked")
        private static SynchedEntityData.DataValue<Integer> createStartInterpolationData(SynchedEntityData.DataValue<?> dataValue) {
            SynchedEntityData.DataValue<Integer> interpolationDelayData = (SynchedEntityData.DataValue<Integer>) dataValue;
            return new SynchedEntityData.DataValue<>(interpolationDelayData.id(), interpolationDelayData.serializer(), 0);
        }

        @Override
        public void setColor(int elementId, int argb) {
            Element element = this.elements.get(elementId);
            if (element == null || element.textDisplay == null)
                return;
            element.textDisplay.setBackgroundColor(Color.fromARGB(argb));
            sendDirtyData(element);
        }

        @Override
        public void setText(int elementId, String text) {
            Element element = this.elements.get(elementId);
            if (element == null || element.textDisplay == null)
                return;
            element.textDisplay.setText(text);
            sendDirtyData(element);
        }

        @Override
        public void setItem(int elementId, ItemStack itemStack) {
            Element element = this.elements.get(elementId);
            if (element == null || !(element.bukkitEntity instanceof ItemDisplay))
                return;
            ((ItemDisplay) element.bukkitEntity).setItemStack(itemStack);
            sendDirtyData(element);
        }

        private void sendDirtyData(Element element) {
            if (!element.spawned)
                return;

            List<SynchedEntityData.DataValue<?>> entityData = element.entity.getEntityData().packDirty();
            if (entityData != null && !entityData.isEmpty())
                sendElementData(element, entityData);
        }

        @Override
        public void removeElements(Collection<Integer> elementIds) {
            List<Element> removedElements = new ArrayList<>(elementIds.size());
            for (int elementId : elementIds) {
                Element element = this.elements.remove(elementId);
                if (element != null)
                    removedElements.add(element);
            }
            sendRemovePacket(removedElements);
        }

        @Override
        public void clear() {
            removeAllElements();
        }

        private void removeAllElements() {
            sendRemovePacket(this.elements.values());
            this.elements.clear();
        }

        private void sendRemovePacket(Collection<Element> elements) {
            int[] entityIds = elements.stream()
                    .filter(element -> element.spawned)
                    .flatMapToInt(element -> java.util.stream.IntStream.of(element.entity.getId(), element.mirrorId))
                    .toArray();
            if (entityIds.length > 0)
                sendPacket(new ClientboundRemoveEntitiesPacket(entityIds));
        }

        @Override
        public Runnable destroy() {
            removeAllElements();

            if (!this.locked)
                return NO_MAIN_THREAD_TASK;

            this.locked = false;

            // The viewer must not be hidden by the packet handler anymore when he is shown again.
            this.packetHandler.viewerHidden = false;

            if (this.channel != null) {
                Channel channel = this.channel;
                channel.eventLoop().execute(() -> {
                    if (channel.pipeline().get(CHANNEL_HANDLER_NAME) != null)
                        channel.pipeline().remove(CHANNEL_HANDLER_NAME);
                });
                this.channel = null;
            }

            if (this.serverPlayer.hasDisconnected())
                return NO_MAIN_THREAD_TASK;

            sendPacket(new ClientboundSetCameraPacket(this.serverPlayer));
            sendPacket(createPassengersPacket(this.vehicleAnchor));
            sendPacket(new ClientboundRemoveEntitiesPacket(this.cameraAnchor.getId(), this.vehicleAnchor.getId(),
                    this.clickTarget.getId(), this.mirroredClickTarget.getId()));

            // The state of the viewer on the server is used from now on, which must be done on the main thread.
            return () -> {
                if (this.serverPlayer.hasDisconnected())
                    return;

                showViewer();

                // The viewer was moved to the location of his vehicle on his side only, so his location must be synced.
                // His rotation is set back to what it was before the menu was opened.
                this.serverPlayer.connection.teleport(this.serverPlayer.getX(), this.serverPlayer.getY(),
                        this.serverPlayer.getZ(), this.initialYaw, this.initialPitch);

                // Riding the vehicle of the menu made the viewer leave his real vehicle on his side.
                Entity realVehicle = this.serverPlayer.getVehicle();
                if (realVehicle != null)
                    sendPacket(new ClientboundSetPassengersPacket(realVehicle));
            };
        }

        private void sendPacket(Packet<?> packet) {
            this.serverPlayer.connection.send(packet);
        }

        @SuppressWarnings({"rawtypes", "unchecked"})
        private void sendBundle(Packet<?>... packets) {
            // The type of the packets of bundles differs between versions, therefore a raw type is used.
            sendPacket(new ClientboundBundlePacket((Iterable) Arrays.asList(packets)));
        }

        private static Packet<?> createPassengersPacket(Entity vehicle, int... passengers) {
            // The packet can only be created from the real passengers of an entity, which the viewer is not one of.
            FriendlyByteBuf buf = new FriendlyByteBuf(Unpooled.buffer());
            try {
                buf.writeVarInt(vehicle.getId());
                buf.writeVarIntArray(passengers);
                return ${SET_PASSENGERS_PACKET_FROM_BUFFER}(buf);
            } finally {
                buf.release();
            }
        }

        private static Packet<?> createSharedFlagsPacket(int entityId, byte sharedFlags) {
            return new ClientboundSetEntityDataPacket(entityId, Collections.<SynchedEntityData.DataValue<?>>singletonList(
                    new SynchedEntityData.DataValue<>(SHARED_FLAGS_DATA_ID, EntityDataSerializers.BYTE, sharedFlags)));
        }

        private static byte getSharedFlags(ServerPlayer serverPlayer) {
            List<SynchedEntityData.DataValue<?>> entityData = serverPlayer.getEntityData().getNonDefaultValues();
            if (entityData != null) {
                for (SynchedEntityData.DataValue<?> dataValue : entityData) {
                    if (dataValue.id() == SHARED_FLAGS_DATA_ID && dataValue.value() instanceof Byte)
                        return (Byte) dataValue.value();
                }
            }

            // The flags are not set, and therefore have their default value.
            return 0;
        }

        private static Packet<?> createInventorySlotPacket(ServerPlayer serverPlayer, int slot, net.minecraft.world.item.ItemStack itemStack) {
            InventoryMenu inventoryMenu = serverPlayer.inventoryMenu;
            return new ClientboundContainerSetSlotPacket(inventoryMenu.containerId, inventoryMenu.getStateId(), slot, itemStack);
        }

        private static Channel findChannel(ServerPlayer serverPlayer) {
            List<Connection> connections = MinecraftServer.getServer().getConnection().getConnections();
            // The list is synchronized, and must be locked while iterating over it.
            synchronized (connections) {
                for (Connection connection : connections) {
                    if (connection.getPacketListener() == serverPlayer.connection)
                        return connection.channel;
                }
            }

            return null;
        }

    }

    private static class Element {

        private final int id;
        private final Display entity;
        // The identifiers of the mirror of the element, which only exists on the side of the viewer.
        private final int mirrorId;
        private final UUID mirrorUUID;
        private final org.bukkit.entity.Display bukkitEntity;
        // Only set for elements that are rendered using texts.
        private final TextDisplay textDisplay;
        // The offset between the center of the element and the location its entity is rendered in.
        private final float offsetX;
        private final float offsetY;
        private final float depth;
        private final Vector3f scale;
        private final AxisAngle4f rotation;
        // The amount the whole element is scaled by towards the viewer.
        private final float viewScale;
        // The size of the element relative to its original size.
        private float sizeScale = 1f;
        private boolean spawned = false;

        Element(int id, Display entity, Entity mirror, float offsetX, float offsetY, float depth, Vector3f scale,
                AxisAngle4f rotation, float viewScale) {
            this.id = id;
            this.entity = entity;
            this.mirrorId = mirror.getId();
            this.mirrorUUID = mirror.getUUID();
            this.bukkitEntity = (org.bukkit.entity.Display) entity.getBukkitEntity();
            this.textDisplay = this.bukkitEntity instanceof TextDisplay ? (TextDisplay) this.bukkitEntity : null;
            this.offsetX = offsetX;
            this.offsetY = offsetY;
            this.depth = depth;
            this.scale = scale;
            this.rotation = rotation;
            this.viewScale = viewScale;
        }

        void setPosition(float x, float y) {
            setPosition(x, y, this.sizeScale);
        }

        /**
         * @param sizeScale The size of the element relative to its original size. It is resized around its center.
         */
        void setPosition(float x, float y, float sizeScale) {
            this.sizeScale = sizeScale;
            this.bukkitEntity.setTransformation(new Transformation(
                    new Vector3f(x + this.offsetX * sizeScale, y + this.offsetY * sizeScale, this.depth).mul(this.viewScale),
                    new AxisAngle4f(this.rotation), new Vector3f(this.scale).mul(this.viewScale * sizeScale), NO_ROTATION));
        }

    }

    /**
     * Captures the inputs of the viewer, and keeps him hidden from himself while the menu is shown.
     */
    private static class PacketHandler extends ChannelDuplexHandler {

        private final ServerPlayer serverPlayer;
        private final InputListener listener;
        private final RendererImpl renderer;
        private final boolean handItemsHidden;
        private boolean exited = false;

        // These are written from the main thread and read from the thread of the channel.
        private volatile boolean viewerHidden = true;
        private volatile int hiddenHotbarSlot = -1;

        PacketHandler(ServerPlayer serverPlayer, InputListener listener, RendererImpl renderer, boolean handItemsHidden) {
            this.serverPlayer = serverPlayer;
            this.listener = listener;
            this.renderer = renderer;
            this.handItemsHidden = handItemsHidden;
        }

        @Override
        public void channelRead(ChannelHandlerContext ctx, Object packet) throws Exception {
            if (packet instanceof ServerboundMovePlayerPacket) {
                // The rotation of the viewer is read here, so the menus thread does not depend on the main thread.
                ServerboundMovePlayerPacket movePlayerPacket = (ServerboundMovePlayerPacket) packet;
                if (movePlayerPacket.hasRotation()) {
                    this.renderer.viewerYaw = movePlayerPacket.getYRot(this.renderer.viewerYaw);
                    this.renderer.viewerPitch = movePlayerPacket.getXRot(this.renderer.viewerPitch);
                }

                // The viewer stays where he opened the menu. Positions he sent before his view was locked,
                // for example while falling, would otherwise still move him.
                if (movePlayerPacket.hasPosition())
                    return;
            }

            if (!handlePacket(packet))
                super.channelRead(ctx, packet);
        }

        @Override
        public void write(ChannelHandlerContext ctx, Object packet, ChannelPromise promise) throws Exception {
            super.write(ctx, this.viewerHidden ? hideViewer(packet) : packet, promise);
        }

        /**
         * Change data the server sends about the viewer so he stays hidden from himself.
         *
         * @return The packet to send instead.
         */
        @SuppressWarnings({"rawtypes", "unchecked"})
        private Object hideViewer(Object packet) {
            if (packet instanceof ClientboundSetEntityDataPacket) {
                ClientboundSetEntityDataPacket entityDataPacket = (ClientboundSetEntityDataPacket) packet;
                if (entityDataPacket.id() == this.serverPlayer.getId())
                    return forceInvisible(entityDataPacket);
            } else if (packet instanceof ClientboundContainerSetSlotPacket) {
                ClientboundContainerSetSlotPacket slotPacket = (ClientboundContainerSetSlotPacket) packet;
                if (slotPacket.getContainerId() == this.serverPlayer.inventoryMenu.containerId &&
                        this.handItemsHidden && isHiddenSlot(slotPacket.getSlot()) && !slotPacket.getItem().isEmpty()) {
                    return new ClientboundContainerSetSlotPacket(slotPacket.getContainerId(), slotPacket.getStateId(),
                            slotPacket.getSlot(), net.minecraft.world.item.ItemStack.EMPTY);
                }
            } else if (packet instanceof ClientboundBundlePacket) {
                List<Object> subPackets = new ArrayList<>();
                boolean changed = false;
                for (Object subPacket : ((ClientboundBundlePacket) packet).subPackets()) {
                    Object newSubPacket = hideViewer(subPacket);
                    changed |= newSubPacket != subPacket;
                    subPackets.add(newSubPacket);
                }
                // The type of the sub-packets differs between versions, therefore a raw type is used.
                if (changed)
                    return new ClientboundBundlePacket((Iterable) subPackets);
            }

            return packet;
        }

        private boolean isHiddenSlot(int slot) {
            int hiddenHotbarSlot = this.hiddenHotbarSlot;
            return slot == InventoryMenu.SHIELD_SLOT ||
                    (hiddenHotbarSlot != -1 && slot == InventoryMenu.USE_ROW_SLOT_START + hiddenHotbarSlot);
        }

        private static Object forceInvisible(ClientboundSetEntityDataPacket packet) {
            List<SynchedEntityData.DataValue<?>> entityData = packet.packedItems();
            for (int i = 0; i < entityData.size(); ++i) {
                SynchedEntityData.DataValue<?> dataValue = entityData.get(i);
                if (dataValue.id() == SHARED_FLAGS_DATA_ID && dataValue.value() instanceof Byte) {
                    byte sharedFlags = (Byte) dataValue.value();
                    if ((sharedFlags & INVISIBLE_FLAG) != 0)
                        return packet;

                    List<SynchedEntityData.DataValue<?>> newEntityData = new ArrayList<>(entityData);
                    newEntityData.set(i, new SynchedEntityData.DataValue<>(SHARED_FLAGS_DATA_ID,
                            EntityDataSerializers.BYTE, (byte) (sharedFlags | INVISIBLE_FLAG)));
                    return new ClientboundSetEntityDataPacket(packet.id(), newEntityData);
                }
            }

            return packet;
        }

        /**
         * @return true if the packet should not be handled by the server.
         */
        private boolean handlePacket(Object packet) {
            // Spectators report left clicks with a packet of their own.
            if (packet instanceof ${SWING_PACKET_CLASS} || packet instanceof ${ATTACK_PACKET_CLASS} ||
                    packet instanceof ${SPECTATOR_ACTION_PACKET_CLASS}) {
                this.listener.onClick(false);
                return true;
            }

            if (packet instanceof ServerboundPlayerInputPacket) {
                // The viewer tries to dismount his vehicle.
                if (!this.exited && ((ServerboundPlayerInputPacket) packet).${PLAYER_INPUT_PACKET_SHIFT_METHOD}) {
                    this.exited = true;
                    this.listener.onExit();
                }
                return true;
            }

            if (packet instanceof ServerboundSetCarriedItemPacket) {
                // The viewer selected a different slot in his hotbar, whose item should be hidden instead.
                // The server still handles the packet, so the selected slot stays in sync.
                int hotbarSlot = ((ServerboundSetCarriedItemPacket) packet).getSlot();
                BukkitExecutor.sync(() -> this.renderer.hideHeldItem(hotbarSlot));
                return false;
            }

            if (packet instanceof ServerboundTeleportToEntityPacket) {
                // Spectators can open a menu for teleporting to other players with their number keys.
                return true;
            }

            if (packet instanceof ServerboundSetCreativeModeSlotPacket) {
                // Players in creative mode set items in their inventory directly.
                // As some of their items are hidden on their side, they could remove them by mistake.
                return true;
            }

            // The viewer should not interact with the world behind the menu.
            // Block interactions are predicted by the viewer, and must be acknowledged in order to be reverted.

            if (packet instanceof ServerboundInteractPacket) {
                // The viewer clicked an entity, such as the entities that receive his clicks.
                ServerboundInteractPacket interactPacket = (ServerboundInteractPacket) packet;
                this.listener.onClick(!(${INTERACT_PACKET_IS_ATTACK}));
                return true;
            }

            if (packet instanceof ServerboundUseItemOnPacket) {
                acknowledgeBlockChange(((ServerboundUseItemOnPacket) packet).${USE_ITEM_PACKET_SEQUENCE_METHOD});
                this.listener.onClick(true);
                return true;
            }

            if (packet instanceof ServerboundUseItemPacket) {
                acknowledgeBlockChange(((ServerboundUseItemPacket) packet).${USE_ITEM_PACKET_SEQUENCE_METHOD});
                this.listener.onClick(true);
                return true;
            }

            if (packet instanceof ServerboundPlayerActionPacket) {
                ServerboundPlayerActionPacket playerActionPacket = (ServerboundPlayerActionPacket) packet;
                switch (playerActionPacket.getAction()) {
                    case START_DESTROY_BLOCK:
                        // The viewer clicked on a block that is behind the menu.
                        this.listener.onClick(false);
                        // fallthrough
                    case ABORT_DESTROY_BLOCK:
                    case STOP_DESTROY_BLOCK:
                        acknowledgeBlockChange(playerActionPacket.getSequence());
                        return true;
                    case DROP_ITEM:
                    case DROP_ALL_ITEMS:
                    case SWAP_ITEM_WITH_OFFHAND:
                        // The items in the hands of the viewer are hidden on his side, and should not be touched.
                        return true;
                    default:
                        return false;
                }
            }

            return false;
        }

        private void acknowledgeBlockChange(int sequence) {
            this.serverPlayer.connection.send(new ClientboundBlockChangedAckPacket(sequence));
        }

    }

}
